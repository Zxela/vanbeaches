{
  "name": "van-beaches",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vancouver beach conditions dashboard",
  "scripts": {
    "3d:export": "python 3d/pipeline.py export",
    "3d:urban": "python 3d/pipeline.py urban",
    "3d:marine": "python 3d/pipeline.py marine",
    "3d:finalize": "python 3d/pipeline.py finalize --threads 4",
    "coast:stamp": "node scripts/coast-assets.mjs stamp",
    "coast:verify": "node scripts/coast-assets.mjs verify",
    "coast:package": "node scripts/coast-assets.mjs package",
    "coast:r2:plan": "node scripts/publish-world-r2.mjs",
    "coast:r2:publish": "node scripts/publish-world-r2.mjs --publish",
    "coast:r2:deploy": "wrangler deploy --config world-assets/wrangler.toml",
    "test:world-assets": "vitest run --config functions/vitest.config.ts world-assets",
    "coast:profile": "node client/scripts/profile-coast.mjs",
    "coast:benchmark": "node 3d/export/benchmark_compression.mjs",
    "dev": "wrangler pages dev client/dist",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "biome check .",
    "format": "biome format --write .",
    "type-check": "pnpm -r type-check",
    "deploy:preview": "wrangler pages deploy client/dist --project-name=vanbeaches",
    "deploy:production": "wrangler pages deploy client/dist --project-name=vanbeaches --branch=master",
    "prepare": "husky",
    "test:functions": "vitest run --config functions/vitest.config.ts functions"
  },
  "dependencies": {
    "@van-beaches/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20260702.1",
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "draco3dgltf": "1.5.7",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "meshoptimizer": "0.25.0",
    "sharp": "0.35.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0",
    "wrangler": "^4.129.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["biome check --write --no-errors-on-unmatched"],
    "*.{json,css,md}": ["biome format --write --no-errors-on-unmatched"]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.3",
      "undici@>=7.0.0 <7.24.0": ">=7.24.0",
      "undici@>=7.17.0 <7.24.0": ">=7.24.0",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "vite@<=6.4.1": ">=6.4.2",
      "vite@>=6.0.0 <=6.4.1": ">=6.4.2",
      "postcss@<8.5.10": ">=8.5.10",
      "ws@>=8.0.0 <8.20.1": ">=8.20.1",
      "react-router@>=7.0.0 <=7.14.1": ">=7.14.2",
      "react-router@>=7.7.0 <7.13.2": ">=7.13.2",
      "react-router@>=7.5.1 <7.13.2": ">=7.13.2",
      "react-router@>=7.0.0 <7.15.0": ">=7.15.0",
      "react-router@>=7.0.0 <7.14.0": ">=7.14.0",
      "esbuild@>=0.27.3 <0.28.1": ">=0.28.1",
      "vite@<=6.4.2": ">=6.4.3",
      "react-router@>=7.12.0 <7.15.1": ">=7.15.1",
      "undici@>=7.0.0 <7.28.0": ">=7.28.0",
      "ws@>=8.0.0 <8.21.0": ">=8.21.0",
      "@babel/core@<=7.29.0": ">=7.29.6",
      "sharp@<0.35.0": ">=0.35.0",
      "postcss@<=8.5.11": ">=8.5.12",
      "react-router@>=6.0.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.9.6 <=7.12.0": ">=7.13.0",
      "react-router@>=7.11.0 <7.18.0": ">=7.18.0",
      "react-router@>=6.4.0 <7.18.0": ">=7.18.0",
      "react-router@>=7.0.0 <7.18.0": ">=7.18.0",
      "postcss@<=8.5.22": ">=8.5.23",
      "undici@>=7.0.0 <7.29.0": ">=7.29.0",
      "react-router@>=7.0.0 <7.14.1": ">=7.14.1",
      "react-router@>=7.12.0 <7.18.2": ">=7.18.2",
      "nanoid@<3.3.16": ">=3.3.16",
      "nanoid@<3.3.18": ">=3.3.18",
      "postcss@<=8.5.17": ">=8.5.18",
      "vitest@<3.2.6": ">=3.2.6",
      "postcss-selector-parser@>=6.1.0 <6.1.3": ">=6.1.3",
      "browserslist@<=4.28.6": ">=4.28.7",
      "nanoid@<3.3.12": ">=3.3.12"
    }
  }
}
