{
  "name": "van-beaches",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Vancouver beach conditions dashboard",
  "scripts": {
    "dev": "wrangler pages dev client/dist",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "check": "biome check .",
    "format": "biome format --write .",
    "type-check": "pnpm -r type-check",
    "deploy:preview": "wrangler pages deploy client/dist --project-name=vanbeaches",
    "deploy:production": "wrangler pages deploy client/dist --project-name=vanbeaches --branch=master",
    "prepare": "husky"
  },
  "dependencies": {
    "@van-beaches/shared": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@cloudflare/workers-types": "^4.20260201.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "typescript": "^5.7.2",
    "wrangler": "^4.68.1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": ["biome check --write"],
    "*.{json,css,md}": ["biome format --write"]
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "pnpm": {
    "overrides": {
      "esbuild": ">=0.25.0",
      "rollup": ">=4.59.0",
      "serialize-javascript": ">=7.0.3"
    }
  }
}
